RewriteEngine On

# use this to rewrite all requests to index.php
#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteRule ^(.*)$ /index.php?path=$1?query=%{QUERY_STRING}&domain=%{HTTP_HOST} [L]

# Rewrite all requests to /app/ to app.php
RewriteCond %{REQUEST_URI} ^/app/.*
RewriteRule ^(.*)$ /app.php?__dy_path=$1&%{QUERY_STRING}&__dy_domain=%{HTTP_HOST} [L]

# Rewrite all requests to /api/ to api.php
RewriteCond %{REQUEST_URI} ^/api/.*
RewriteRule ^(.*)$ /api.php?__dy_path=$1&%{QUERY_STRING}&__dy_domain=%{HTTP_HOST} [L]